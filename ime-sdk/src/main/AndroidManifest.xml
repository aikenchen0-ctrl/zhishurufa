<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application>

        <service
            android:name="com.osfans.trime.ime.core.TrimeInputMethodService"
            android:exported="true"
            android:label="@string/trime_app_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/trime_method" />
        </service>

        <provider
            android:name="com.osfans.trime.provider.RimeDataProvider"
            android:authorities="${applicationId}.trime.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

        <!-- SDK 界面独立设置主题，避免依赖或覆盖宿主主题。 -->
        <activity
            android:name="com.osfans.trime.ui.main.MainActivity"
            android:exported="true"
            android:label="@string/trime_app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.TrimeSdkAppTheme"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name="com.osfans.trime.ui.setup.SetupActivity"
            android:exported="false"
            android:label="@string/trime_app_name"
            android:theme="@style/Theme.TrimeSdkAppTheme" />

        <activity
            android:name="com.osfans.trime.ui.main.LogActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:parentActivityName="com.osfans.trime.ui.main.MainActivity"
            android:theme="@style/Theme.TrimeSdkAppTheme" />

        <activity
            android:name="com.osfans.trime.ui.main.settings.theme.ThemeDiagnosticsActivity"
            android:exported="false"
            android:parentActivityName="com.osfans.trime.ui.main.MainActivity"
            android:theme="@style/Theme.TrimeSdkAppTheme" />

        <activity
            android:name="com.osfans.trime.ui.main.ClipEditActivity"
            android:autoRemoveFromRecents="true"
            android:excludeFromRecents="true"
            android:exported="false"
            android:label="@string/edit"
            android:launchMode="singleInstance"
            android:taskAffinity="${applicationId}.trime.clipboard"
            android:theme="@style/Theme.TrimeSdkDialogTheme"
            android:windowSoftInputMode="stateAlwaysVisible|adjustPan" />
    </application>
</manifest>
